# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Production Environment Variables
# Add these in your Render (or Vercel) dashboard under Environment.
# NEVER commit this file with real values filled in.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Must point to your deployed backend URL — no trailing slash.
NEXT_PUBLIC_API_URL=https://realestate-booking-api.onrender.com/api

# ── Blockchain (optional) ─────────────────────────────────────────────────────
# Leave blank to disable on-chain features in the UI.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_HARDHAT_RPC=
