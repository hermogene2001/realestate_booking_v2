# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/

# ── Environment / Secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
# Keep the *.example files — they are safe reference templates
!.env.example
!.env.production.example

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── Uploaded files (binary user content, not tracked in git) ─────────────────
uploads/*
!uploads/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
server.err

# ── Test / Coverage ───────────────────────────────────────────────────────────
coverage/
.jest-cache/

# ── Blockchain build artefacts ────────────────────────────────────────────────
artifacts/
cache/
typechain-types/

# ── Mobile ────────────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
mobile_app/android/local.properties

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

