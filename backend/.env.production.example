# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Production Environment Variables
# Copy relevant values into your Render dashboard under Environment.
# NEVER commit this file with real values filled in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000          # Render requires 10000 for web services

# ── Database ──────────────────────────────────────────────────────────────────
# Render injects this automatically via the "fromDatabase" binding in render.yaml.
# If setting manually: get the External Connection String from your Render DB page.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/realestate_booking?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS / Frontend URL ───────────────────────────────────────────────────────
# Set to your actual Render frontend URL (or Vercel URL if using that).
FRONTEND_URL=https://realestate-booking-frontend.onrender.com
CORS_ORIGIN=https://realestate-booking-frontend.onrender.com

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880   # 5 MB in bytes

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use an App Password, not your real Gmail password.
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_EMAIL=noreply@kigali-re.com

# ── AI Services ───────────────────────────────────────────────────────────────
# Fill in whichever provider you use; leave the others blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama runs locally only — disable in production
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ── Blockchain (optional) ─────────────────────────────────────────────────────
# Leave blank to disable on-chain features.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_WS_URL=
CONTRACT_ADDRESS=
ADMIN_WALLET_ADDRESS=
ADMIN_WALLET_PRIVATE_KEY=   # ⚠ Store in Render secrets, never in code

PROPERTY_TOKEN_ADDRESS=
REPUTATION_SCORE_ADDRESS=

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Add a Redis service on Render and paste the Internal Redis URL here.
REDIS_URL=
REDIS_ENABLED=false

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
